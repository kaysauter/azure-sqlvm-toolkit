    "slides:build": "npm run build:slides",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.4",
    "astro": "^7.1.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@slidev/cli": "52.16.0",
    "@slidev/theme-default": "^0.25.0"
  },
  "overrides": {
    "dompurify": "3.4.12",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.0"
  }
}
