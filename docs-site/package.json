{
  "name": "docs-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run build:astro && npm run build:slides",
    "build:astro": "astro build",
    "build:slides": "slidev build pitch.md --base /azure-sqlvm-toolkit/pitch/deck/ --out dist/pitch/deck --without-notes --router-mode hash && node scripts/fix-slidev-hash-routes.mjs",
    "preview": "node scripts/preview-docs.mjs",
    "preview:astro": "astro preview",
    "slides": "slidev pitch.md",
    "slides:build": "npm run build:slides",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.40.0",
    "astro": "^6.4.7",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@slidev/cli": "^52.16.0",
    "@slidev/theme-default": "^0.25.0"
  },
  "overrides": {
    "dompurify": "3.4.10",
    "esbuild": "0.28.1",
    "js-yaml": "4.2.0"
  }
}
