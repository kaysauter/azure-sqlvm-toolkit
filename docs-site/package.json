{
  "name": "docs-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run build:astro && npm run build:slides",
    "build:astro": "astro build",
    "build:slides": "slidev build pitch.md --base /azure-sqlvm-toolkit/pitch/deck/ --out dist/pitch/deck && node scripts/fix-slidev-hash-routes.mjs",
    "preview": "node scripts/preview-docs.mjs",
    "preview:astro": "astro preview",
