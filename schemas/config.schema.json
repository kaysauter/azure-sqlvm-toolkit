{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaysauter.github.io/azure-sqlvm-toolkit/schemas/config.schema.json",
  "title": "AzureSqlVmToolkit configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resourceGroup",
    "network",
    "securityRules",
    "keyVault",
    "credentials",
    "vm",
    "bastion",
    "storage",
    "softwareInstalls"
  ],
  "properties": {
    "resourceGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "location", "tags"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._()\\-]{1,90}$"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vnet", "subnet", "publicIp"],
      "properties": {
        "vnet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["addressPrefix"],
          "properties": {
            "addressPrefix": {
              "$ref": "#/$defs/ipv4Cidr"
            }
          }
        },
        "subnet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["addressPrefix"],
          "properties": {
            "addressPrefix": {
              "$ref": "#/$defs/ipv4Cidr"
            }
          }
        },
        "publicIp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "allocationMethod", "idleTimeoutInMinutes"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "allocationMethod": {
              "type": "string",
              "enum": ["Static", "Dynamic"]
            },
            "idleTimeoutInMinutes": {
              "type": "integer",
              "minimum": 4,
              "maximum": 30
            }
          }
        }
      }
    },
    "securityRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "protocol",
          "direction",
          "priority",
          "sourceAddressPrefix",
          "sourcePortRange",
          "destinationAddressPrefix",
          "destinationPortRange",
          "access"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,80}$"
          },
          "protocol": {
            "type": "string",
            "enum": ["Tcp", "Udp", "Icmp", "*"]
          },
          "direction": {
            "type": "string",
            "enum": ["Inbound", "Outbound"]
          },
          "priority": {
            "type": "integer",
            "minimum": 100,
            "maximum": 4096
          },
          "sourceAddressPrefix": {
            "type": "string",
            "minLength": 1
          },
          "sourcePortRange": {
            "type": "string",
            "minLength": 1
          },
          "destinationAddressPrefix": {
            "type": "string",
            "minLength": 1
          },
          "destinationPortRange": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "type": "string",
            "enum": ["Allow", "Deny"]
          }
        }
      }
    },
    "keyVault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "storageKeySecretName", "vmAdminPasswordSecretName", "passwordLength"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[A-Za-z][A-Za-z0-9-]{1,22}[A-Za-z0-9]$"
        },
        "storageKeySecretName": {
          "$ref": "#/$defs/keyVaultSecretName"
        },
        "vmAdminPasswordSecretName": {
          "$ref": "#/$defs/keyVaultSecretName"
        },
        "passwordLength": {
          "type": "integer",
          "minimum": 12,
          "maximum": 128
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username"],
      "properties": {
        "username": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,19}$"
        }
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "image"],
      "properties": {
        "size": {
          "$ref": "#/$defs/azureToken"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publisherName", "offer", "skus", "version"],
          "properties": {
            "publisherName": {
              "$ref": "#/$defs/azureToken"
            },
            "offer": {
              "$ref": "#/$defs/azureToken"
            },
            "skus": {
              "$ref": "#/$defs/azureToken"
            },
            "version": {
              "$ref": "#/$defs/azureToken"
            }
          }
        }
      }
    },
    "bastion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subnetAddressPrefix", "sku", "publicIp"],
      "properties": {
        "subnetAddressPrefix": {
          "$ref": "#/$defs/ipv4Cidr"
        },
        "sku": {
          "type": "string",
          "enum": ["Basic", "Standard", "Premium"]
        },
        "publicIp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allocationMethod", "idleTimeoutInMinutes", "sku"],
          "properties": {
            "allocationMethod": {
              "type": "string",
              "enum": ["Static"]
            },
            "idleTimeoutInMinutes": {
              "type": "integer",
              "minimum": 4,
              "maximum": 30
            },
            "sku": {
              "type": "string",
              "enum": ["Standard"]
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceGroup", "accountName", "skuName", "fileShareName", "driveLetter", "backupPath"],
      "properties": {
        "resourceGroup": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._()\\-]{1,90}$"
        },
        "accountName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9]{3,24}$"
        },
        "skuName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "fileShareName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])?$"
        },
        "driveLetter": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "backupPath": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^[A-Za-z]:)|(^\\\\\\\\)|\\.\\.|[\"'`;&|<>*?]"
          }
        }
      }
    },
    "softwareInstalls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installScript"],
      "properties": {
        "allowDynamicBootstrap": {
          "type": "boolean",
          "default": false
        },
        "chocolatey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bootstrapUrl": {
              "type": "string",
              "format": "uri"
            },
            "bootstrapSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manager", "name", "version"],
            "properties": {
              "manager": {
                "type": "string",
                "enum": ["Chocolatey", "PowerShellGallery"]
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,128}$"
              },
              "version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._+-]{1,64}$"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "sourceUri": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "installScript": {
          "type": "string",
          "minLength": 1
        },
        "logonScript": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "ipv4Cidr": {
      "type": "string",
      "pattern": "^(?:\\d{1,3}\\.){3}\\d{1,3}/\\d{1,2}$"
    },
    "keyVaultSecretName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 127,
      "pattern": "^[A-Za-z0-9-]{1,127}$"
    },
    "azureToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    }
  }
}
